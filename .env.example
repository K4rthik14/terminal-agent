# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# LLM Provider: "openai" | "anthropic"
AGENT_PROVIDER=openai

# Model name as accepted by the provider.
# Uncomment to override the built-in default (poolside/laguna-s-2.1:free),
# or set it via the AGENT_MODEL environment variable or --model flag.
# AGENT_MODEL=

# Provider API key
AGENT_API_KEY=sk-...

# Max tokens per LLM response
AGENT_MAX_TOKENS=4096

# Approval mode: "always" | "never" | "auto"
# always = prompt for every tool call
# never  = skip approval (use with caution)
# auto   = only prompt for destructive tools (bash, file_write overwrite)
AGENT_APPROVAL_MODE=auto

# Log level: "debug" | "info" | "warning" | "error"
AGENT_LOG_LEVEL=info
